{
    "name": "allus/company-data-example",
    "description": "Runnable company-data example (connections read / request fields / change feed / webhooks / documents) for the allus company-data PHP SDK. Its own composer sub-project — NOT part of the published SDK package.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "allus/company-data": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Allus\\CompanyDataExample\\": "src/"
        }
    },
    "archive": {
        "exclude": ["/vendor", "/.runtime", "/.frontend", "/.DS_Store"]
    },
    "scripts": {
        "start": "@php bin/start.php"
    }
}
