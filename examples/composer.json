{
    "name": "allus/examples",
    "description": "Runnable examples (identity sign-in/OIDC/2FA · company-data · contract flow) for the allus company-data PHP SDK — ONE server, shared scaffolding, all three scenario families on one port. Its own composer sub-project — not separately published, but its source ships inside the SDK package (#493).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "allus/company-data": "*",
        "facile-it/php-openid-client": "^0.3",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^6 || ^7",
        "spomky-labs/aes-key-wrap": "^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Allus\\Examples\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "archive": {
        "exclude": ["/vendor", "/.runtime", "/.frontend", "/.DS_Store"]
    },
    "scripts": {
        "start": "@php bin/start.php"
    }
}
